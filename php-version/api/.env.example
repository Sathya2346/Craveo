# ---- App ----
APP_ENV=development
APP_DEBUG=true

# Comma separated list of allowed frontend origins (production)
CLIENT_ORIGIN=http://localhost:5173

# ---- MySQL (XAMPP defaults) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=craveo
# Managed MySQL hosts (Aiven, Railway, Clever Cloud) usually require TLS
DB_SSL=false

# ---- Auth ----
# Generate one: php -r "echo bin2hex(random_bytes(48));"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Uploads ----
MAX_UPLOAD_MB=5
