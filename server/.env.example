# ---- Server ----
NODE_ENV=development
PORT=5000

# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=craveo

# Set to true for managed MySQL hosts that require TLS (Aiven, Railway, Clever Cloud)
DB_SSL=false

# Used by the test suite (created and dropped by the tests)
DB_NAME_TEST=craveo_test

# ---- Auth ----
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Uploads ----
MAX_UPLOAD_MB=5
